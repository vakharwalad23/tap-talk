# Markdown is opt-in.
#
# Everything .md is ignored by default and re-included by name below
*.md
!README.md
!CLAUDE.md
!MODEL-LICENSES.md
!docs/*.md
!.claude/rules/*.md
!website/README.md
!orukeet-coreml/**/*.md

# Local working notes - plans, measurements, eval data. Never shipped.
docs/plan/

# Rust
core/target/
**/*.rs.bk
Cargo.lock

# Xcode
TapTalk.xcodeproj/
build/
DerivedData/
*.xcuserdata/
*.xcscmblueprint
*.xccheckout

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
*.swp
*.swo
*~

# Models (downloaded at runtime - only the app support dir, not source)
/models/

# Secrets & environment
.env
.env.*
*.pem
*.key
*.p12
*.mobileprovision
*.provisionprofile

# Claude (only rules committed - plans, memory, settings are local)
.claude/settings.local.json
.claude/plans/
.claude/memory/
.claude/todos/

# Distribution artifacts
dist/

# IDE
.idea/
.vscode/
*.code-workspace

# Logs & temp
*.log
tmp/
temp/
*.tmp
