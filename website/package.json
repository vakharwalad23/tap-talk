{
	"name": "taptalk-website",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"generate-routes": "tsr generate",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"check": "biome check",
		"format": "biome format --write",
		"lint": "biome lint",
		"cf-typegen": "wrangler types",
		"deploy": "pnpm run check && pnpm run typecheck && pnpm run build && wrangler deploy"
	},
	"dependencies": {
		"@tanstack/react-router": "^1.170.32",
		"@tanstack/react-start": "^1.168.49",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@cloudflare/vite-plugin": "^1.26.0",
		"@tanstack/router-cli": "^1.132.0",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"wrangler": "^4.70.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss",
			"sharp",
			"workerd"
		]
	}
}
